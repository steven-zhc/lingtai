node_modules/
dist/
*.tsbuildinfo

# Next.js
.next/
next-env.d.ts
# `next build` with `output: "export"` writes the site here.
out/

# Secrets. The event store URL and the GitHub App key never enter git.
.env
.env.*
!.env.example

# Prisma 8 emits contract.json and contract.d.ts next to the schema. They are
# committed: they are deterministic output of contract.prisma, and db.ts imports
# contract.json at runtime, so the tree works without a build step.

# Agent worktrees and run scratch, once the conductor exists.
.runtime/
worktrees/
logs/

# Bun writes compile artefacts as dotfiles in the working directory, so a
# `git add -A` sweeps them in: six of these, 55MB deduplicated, were committed
# once before this line existed.
*.bun-build

.DS_Store

# The site's build products. `public/doc/` is a copy of `doc/architecture.html`
# that `apps/site` makes before every build, and `snapshot.json` is the board
# read out of the log at build time — both are generated, and a copy of either
# in git is a second file to keep in step.
apps/site/public/doc/
apps/site/snapshot.json

# `vercel link` and `vercel build` write here. The link is one machine's
# association with one Vercel project, and `.vercel/output/` is the built site
# — neither is a fact about this repository. What *is* a fact about it is
# `vercel.json`, which is committed.
.vercel/
