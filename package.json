{
  "name": "lingtai",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Event-sourced scheduler for autonomous code agents",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm --filter @lingtai/release build",
    "binary": "pnpm --filter @lingtai/release binary",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:db": "pnpm test:integration",
    "test:all": "vitest run",
    "lingtai": "node apps/cli/src/entry.ts",
    "contract:emit": "pnpm --filter @lingtai/event-store contract:emit",
    "db:plan": "pnpm --filter @lingtai/event-store db:plan",
    "db:init": "pnpm --filter @lingtai/event-store db:init",
    "db:bootstrap": "pnpm --filter @lingtai/event-store db:bootstrap",
    "db:migrate": "pnpm --filter @lingtai/event-store db:migrate",
    "db:verify": "pnpm --filter @lingtai/event-store db:verify"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
