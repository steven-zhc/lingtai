{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // The floor, written out rather than left to the default (0064 §5). `correctness`
  // is what oxlint enables on its own today and what found the 47 problems #366
  // was filed for; saying it here means a later oxlint changing its default
  // cannot widen or narrow this gate without the change showing in a diff.
  // `pedantic` and `style` are deliberately not on: the point is an enforced
  // floor, not a new style argument.
  "categories": {
    "correctness": "warn"
  },

  "rules": {
    // Type-aware linting (#1136) is on for `typescript/await-thenable` alone: an
    // `await` of an Effect compiles and does nothing, which `tsc` cannot see. The
    // `correctness` category also holds fourteen other type-aware rules, which
    // `--type-aware` would switch on; they are off by name because turning any of
    // them on is a ticket of its own. This list is bound to oxlint 1.86: a later
    // oxlint that adds a type-aware rule to `correctness` enables it with no diff.
    "typescript/await-thenable": "warn",
    "typescript/no-array-delete": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-duplicate-type-constituents": "off",
    "typescript/no-floating-promises": "off",
    "typescript/no-for-in-array": "off",
    "typescript/no-implied-eval": "off",
    "typescript/no-meaningless-void-operator": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-unsafe-unary-minus": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/unbound-method": "off",

    // `then:` is a real field of the `watch` plugin, declared as
    // `then: z.enum(["request-approval", "fail"])` in packages/recipe/src/recipe.ts.
    // Renaming it would change the schema every machine's `recipe.yml` is
    // written in, so the ten hits this rule reports are false positives and the
    // rule is off rather than silenced site by site (#366).
    "unicorn/no-thenable": "off",

    // Two exemptions, both of them recognising something the code already does.
    //
    // `ignoreRestSiblings`: `const { seq, streamId, at, ...rest } = envelope` is
    // how a test says *the payload without its bookkeeping*, and those three
    // names exist in order to be left out of `rest`. Renaming them to `_seq`
    // would not silence the rule, it would change the meaning — `_seq` omits
    // nothing and `seq` reappears inside `rest`.
    //
    // `^_`: this repository already marks a binding it keeps on purpose with a
    // leading underscore (`_context`, `_work`, `_refused`), which is what the
    // rule's own help text asks for — so it is told to honour the convention it
    // recommends instead of reporting it.
    "no-unused-vars": [
      "warn",
      {
        "ignoreRestSiblings": true,
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  }
}
